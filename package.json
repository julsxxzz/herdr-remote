{
  "name": "herdr-remote",
  "version": "0.1.0",
  "description": "Remote, read-only-by-default web view for Herdr terminals",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "herdr-remote": "src/cli.js"
  },
  "scripts": {
